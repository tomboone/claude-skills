# Copy to `.env` at the repo root and fill in your values.
# Loaded by plugins/personal/scripts/loop.py at startup. Real environment
# variables always take precedence over anything set here.
#
# Search order: $PUSHOVER_ENV_FILE, then <repo-root>/.env, then ~/.claude/.env.

# Pushover credentials for `loop.py --notify pushover` (https://pushover.net).
PUSHOVER_APP_TOKEN=your-app-token
PUSHOVER_USER_KEY=your-user-key
